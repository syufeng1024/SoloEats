# 复制为 .env 后修改。不要提交 .env。
# MySQL
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=solo_eats
MYSQL_USER=solo
MYSQL_PASSWORD=change_me_mysql
MYSQL_PORT=3306

# Redis
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=solo
RABBITMQ_PASSWORD=change_me_rabbitmq
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO
MINIO_ROOT_USER=change_me_minio
MINIO_ROOT_PASSWORD=change_me_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=solo-eats

# 国内网络镜像前缀；Docker Hub 可直连时留空
# 1ms.run 可用；daocloud 对部分镜像（如 nginx）返回 EOF
REGISTRY_PREFIX=docker.1ms.run/
# MinIO 官方镜像已下架，使用兼容 fork Silo
SILO_IMAGE=docker.1ms.run/pgsty/silo:RELEASE.2026-09-16T00-00-00Z

# Spring Boot
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=change_me_change_me_change_me_32bytes
DB_POOL_MAX=20
DB_POOL_MIN=5
# 本地联调 DEBUG 会打印 SQL 参数；生产设为 INFO
LOG_LEVEL_SOLOEATS=DEBUG

# 宿主机运行时的连接地址；容器内由 docker-compose 覆盖为服务名
MYSQL_HOST=localhost
REDIS_HOST=localhost
RABBITMQ_HOST=localhost
MINIO_ENDPOINT=http://localhost:9000

# 容器编排
APP_PORT=8080
APP_IMAGE=solo-eats-app:latest
# 国内网络使用镜像站；Docker Hub 可直连时改为官方镜像名
MAVEN_IMAGE=docker.1ms.run/library/maven:3.9-eclipse-temurin-17
JRE_IMAGE=docker.1ms.run/library/eclipse-temurin:17-jre-alpine
# 构建阶段 Maven 镜像；留空则直连 Maven Central
MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
APP_JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+UseG1GC -Duser.timezone=Asia/Shanghai

# 前端（商家中心 / 运营后台）
WEB_PORT=5173
WEB_IMAGE=solo-eats-web:latest
NODE_IMAGE=docker.1ms.run/library/node:20-alpine
NGINX_IMAGE=docker.1ms.run/library/nginx:1.27-alpine
# 构建阶段 npm 镜像；留空则直连 registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com

# Flyway
# true = 由 Spring Boot 执行 classpath:db/migration/V1__init_schema.sql
# 手动执行过 V1 后改为 false，避免重复建表
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration

# Payment / Timeout
ORDER_TIMEOUT_DELAY_SECONDS=900
PAYMENT_CALLBACK_SECRET=change_me_payment_callback_secret

# Rate limit
RATE_LIMIT_ORDER_CREATE=20
RATE_LIMIT_PAYMENT_PAY=20
RATE_LIMIT_AUTH_LOGIN=10
