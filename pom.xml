<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.soloeats</groupId>
    <artifactId>solo-eats-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>solo-eats</name>
    <description>数创星光外卖 - Spring Boot 3 模块化单体</description>

    <modules>
        <module>solo-eats-common</module>
        <module>solo-eats-system</module>
        <module>solo-eats-member</module>
        <module>solo-eats-merchant</module>
        <module>solo-eats-store</module>
        <module>solo-eats-marketing</module>
        <module>solo-eats-product</module>
        <module>solo-eats-delivery</module>
        <module>solo-eats-order</module>
        <module>solo-eats-payment</module>
        <module>solo-eats-settlement</module>
        <module>solo-eats-message</module>
        <module>solo-eats-app</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <redisson.version>3.52.0</redisson.version>
        <minio.version>8.6.0</minio.version>
        <!-- MinIO 8.6.0 依赖 okhttp 5.x；Maven 下 okhttp 主构件是 KMP 元数据包，
             编译期类型（okhttp3.HttpUrl 等）在 okhttp-jvm 中 -->
        <okhttp.version>5.1.0</okhttp.version>
        <!-- okhttp-jvm 5.1.0 / okio-jvm 3.15.0 由 Kotlin 2.x 编译；Spring Boot 默认管理
             1.9.25，运行时会出现 NoSuchMethodError，故跟随上游要求提升 -->
        <kotlin.version>2.2.0</kotlin.version>
        <jjwt.version>0.12.6</jjwt.version>
        <!-- 覆盖 Spring Boot 3.5.16 默认版本，修复 High/Critical CVE -->
        <tomcat.version>10.1.61</tomcat.version>
        <jackson-bom.version>2.22.4</jackson-bom.version>
        <netty.version>4.1.139.Final</netty.version>
        <!-- Spring Boot 3.2.12 默认管理 1.19.8；Docker Engine 29 最低 API 1.44，
             1.21.4 内置 docker-java 3.4.2 才能完成版本协商 -->
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          VSCode Red Hat Java 语言服务器会并发写入 target/classes，与 Maven 构建冲突。
          本地跑全量测试时使用 -Pisolated-build，输出到 target-mvn。
        -->
        <profile>
            <id>isolated-build</id>
            <build>
                <directory>${project.basedir}/target-mvn</directory>
            </build>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rabbitmq</groupId>
                <artifactId>amqp-client</artifactId>
                <version>5.37.0</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>1.86</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp-jvm</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-member</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-merchant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-store</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-marketing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-product</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-delivery</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-order</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-payment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-settlement</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-message</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
