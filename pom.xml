<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>

    <groupId>com.soloeats</groupId>
    <artifactId>solo-eats-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>solo-eats</name>
    <description>数创星光外卖 - Spring Boot 3 模块化单体</description>

    <modules>
        <module>solo-eats-common</module>
        <module>solo-eats-marketing</module>
        <module>solo-eats-product</module>
        <module>solo-eats-delivery</module>
        <module>solo-eats-order</module>
        <module>solo-eats-payment</module>
        <module>solo-eats-settlement</module>
        <module>solo-eats-app</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <redisson.version>3.27.2</redisson.version>
        <minio.version>8.5.10</minio.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-marketing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-product</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-delivery</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-order</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-payment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.soloeats</groupId>
                <artifactId>solo-eats-settlement</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
